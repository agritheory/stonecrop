{
	"name": "@stonecrop/graphql-client",
	"version": "0.6.3",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "graphql_client"
	},
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/graphql-client.js"
			},
			"require": "./dist/graphql-client.umd.cjs"
		},
		"./types": {
			"import": "./dist/src/types/index.d.ts",
			"require": "./dist/src/types/index.d.ts"
		}
	},
	"typings": "./dist/src/index.d.ts",
	"files": [
		"dist/*",
		"src/*"
	],
	"scripts": {
		"_phase:build": "heft build && vite build && rushx docs",
		"prepublish": "heft build && vite build && rushx docs",
		"build": "heft build && vite build && rushx docs",
		"dev": "vite",
		"docs": "bash ../common/scripts/run-docs.sh graphql_client",
		"lint": "eslint .",
		"preview": "vite preview"
	},
	"dependencies": {
		"@stonecrop/stonecrop": "workspace:*",
		"decimal.js": "^10.4.3",
		"graphql": "^16.11.0",
		"graphql-request": "~6.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@microsoft/api-documenter": "^7.27.3",
		"@miragejs/graphql": "^0.1.13",
		"@rushstack/heft": "^1.1.3",
		"@vitejs/plugin-vue": "^6.0.1",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.5.1",
		"globals": "^16.4.0",
		"miragejs": "^0.1.48",
		"stonecrop-rig": "workspace:*",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"vite": "^7.1.7",
		"vue": "^3.5.22",
		"vue-router": "^4.6.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
