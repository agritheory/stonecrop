{
	"name": "@stonecrop/graphql-client",
	"version": "0.29.0",
	"description": "GraphQL client integration for Stonecrop",
	"keywords": [
		"client",
		"graphql",
		"stonecrop",
		"vue"
	],
	"homepage": "https://github.com/agritheory/stonecrop#readme",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "graphql_client"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/graphql-client.d.ts",
	"exports": {
		".": {
			"types": "./dist/graphql-client.d.ts",
			"import": "./dist/graphql-client.js"
		},
		"./types": "./dist/src/types/index.d.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite",
		"docs": "bash ../common/scripts/run-docs.sh graphql_client",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "vp run build",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@stonecrop/schema": "workspace:*"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "catalog:",
		"@miragejs/graphql": "^0.1.13",
		"@stonecrop/graphql-middleware": "workspace:*",
		"@types/node": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"@vitest/coverage-istanbul": "catalog:",
		"graphql": "catalog:",
		"miragejs": "^0.1.48",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vue": "catalog:",
		"vue-router": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
