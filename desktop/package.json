{
	"name": "@stonecrop/desktop",
	"version": "0.11.7",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "desktop"
	},
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"types": "./dist/desktop.d.ts",
	"exports": {
		".": {
			"types": "./dist/desktop.d.ts",
			"import": "./dist/desktop.js"
		},
		"./styles": "./dist/desktop.css",
		"./types": "./dist/src/types/index.d.ts"
	},
	"files": [
		"dist/*",
		"src/*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"_phase:build": "heft build && vite build && rushx docs",
		"prepublishOnly": "heft build && vite build && rushx docs",
		"build": "heft build && vite build && rushx docs",
		"docs": "bash ../common/scripts/run-docs.sh desktop",
		"lint": "eslint .",
		"test": "vitest run --coverage.enabled false",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@stonecrop/aform": "workspace:*",
		"@stonecrop/atable": "workspace:*",
		"@stonecrop/stonecrop": "workspace:*",
		"@stonecrop/themes": "workspace:*"
	},
	"peerDependencies": {
		"vue": "^3.5.33"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@microsoft/api-documenter": "^7.30.5",
		"@miragejs/graphql": "^0.1.13",
		"@rushstack/heft": "^1.2.17",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vitest/coverage-istanbul": "^4.1.5",
		"@vue/test-utils": "^2.4.10",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.9.0",
		"globals": "^17.6.0",
		"immutable": "^5.1.4",
		"jsdom": "^29.1.1",
		"miragejs": "^0.1.48",
		"stonecrop-rig": "workspace:*",
		"pinia": "^3.0.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1",
		"vue": "^3.5.33",
		"vite": "^7.3.2",
		"vitest": "^4.1.5",
		"vue-router": "^5.0.6"
	},
	"description": "Desktop-specific components for Stonecrop UI",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
