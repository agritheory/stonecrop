{
	"name": "@stonecrop/examples",
	"version": "0.2.6",
	"description": "Example App(s) for the Stonecrop framework",
	"private": true,
	"type": "module",
	"license": "MIT",
	"main": "index.js",
	"files": [
		"aform/*",
		"docbuilder/*"
	],
	"scripts": {
		"_phase:build": "",
		"build": "",
		"dev:aform": "./dev-runner.sh aform",
		"dev:atable": "./dev-runner.sh atable",
		"dev:beam": "./dev-runner.sh beam",
		"dev:builder": "vite serve docbuilder/ --config docbuilder/vite.config.ts",
		"dev:code_editor": "./dev-runner.sh code_editor",
		"dev:desktop": "vite dev desktop/ --config desktop/vite.config.ts",
		"dev:graphql_client": "vite dev graphql_client/ --config graphql_client/vite.config.ts",
		"dev:node_editor": "./dev-runner.sh node_editor"
	},
	"dependencies": {
		"@stonecrop/aform": "workspace:*",
		"@stonecrop/atable": "workspace:*",
		"@stonecrop/beam": "workspace:*",
		"@stonecrop/code-editor": "workspace:*",
		"@stonecrop/desktop": "workspace:*",
		"@stonecrop/graphql-client": "workspace:*",
		"@stonecrop/node-editor": "workspace:*",
		"@stonecrop/stonecrop": "workspace:*",
		"@stonecrop/themes": "workspace:*",
		"@miragejs/graphql": "^0.1.13",
		"miragejs": "^0.1.48",
		"pinia": "^3.0.3",
		"vite": "^7.1.1",
		"vue": "^3.5.22",
		"vue-toast-notification": "^3",
		"xstate": "^5.20.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@histoire/plugin-vue": "^1.0.0-alpha.4",
		"@monaco-editor/loader": "^1.6.1",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue-flow/core": "^1.47.0",
		"concurrently": "^9.2.0",
		"eslint": "^9.38.0",
		"eslint-plugin-vue": "^10.5.1",
		"globals": "^16.4.0",
		"histoire": "^1.0.0-alpha.4",
		"immutable": "^5.1.4",
		"monaco-editor": "^0.54.0",
		"portal-vue": "^3.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"vue-router": "^4.6.3"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
