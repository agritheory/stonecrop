[
	{
		"fieldname": "line_items",
		"component": "ATable",
		"label": "Order Line Items",
		"schema": [
			{
				"fieldname": "item_code",
				"label": "SKU",
				"fieldtype": "Data",
				"align": "left",
				"edit": false,
				"width": "16ch"
			},
			{
				"fieldname": "item_name",
				"label": "Product",
				"fieldtype": "Data",
				"align": "left",
				"edit": false,
				"width": "32ch"
			},
			{
				"fieldname": "quantity",
				"label": "Qty",
				"fieldtype": "Int",
				"align": "center",
				"edit": true,
				"width": "10ch"
			},
			{
				"fieldname": "unit_price",
				"label": "Unit Price",
				"fieldtype": "Currency",
				"align": "right",
				"edit": false,
				"width": "16ch",
				"format": "value => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value ?? 0)"
			},
			{
				"fieldname": "total",
				"label": "Total",
				"fieldtype": "Currency",
				"align": "right",
				"edit": false,
				"width": "16ch",
				"format": "value => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value ?? 0)"
			},
			{
				"fieldname": "ship_date",
				"label": "Ship Date",
				"fieldtype": "Date",
				"modalComponent": "ADatePicker",
				"align": "center",
				"edit": true,
				"width": "20ch",
				"format": "value => value ? new Date(value).toLocaleDateString('en-US') : '—'"
			},
			{
				"fieldname": "status",
				"label": "Status",
				"fieldtype": "Select",
				"align": "center",
				"edit": true,
				"width": "14ch"
			}
		],
		"config": { "view": "list", "fullWidth": true }
	}
]
