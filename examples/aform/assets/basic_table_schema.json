[
	{
		"fieldname": "line_items",
		"kind": "table",
		"component": "ATable",
		"label": "Order Line Items",
		"schema": [
			{
				"fieldname": "item_code",
				"label": "SKU",
				"component": "ATextInput",
				"align": "left",
				"edit": false,
				"width": "16ch"
			},
			{
				"fieldname": "item_name",
				"label": "Product",
				"component": "ATextInput",
				"align": "left",
				"edit": false,
				"width": "32ch"
			},
			{
				"fieldname": "quantity",
				"label": "Qty",
				"component": "ANumericInput",
				"align": "center",
				"edit": true,
				"width": "10ch"
			},
			{
				"fieldname": "unit_price",
				"label": "Unit Price",
				"component": "ANumericInput",
				"align": "right",
				"edit": false,
				"width": "16ch",
				"format": "value => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value ?? 0)"
			},
			{
				"fieldname": "total",
				"label": "Total",
				"component": "ANumericInput",
				"align": "right",
				"edit": false,
				"width": "16ch",
				"format": "value => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value ?? 0)"
			},
			{
				"fieldname": "ship_date",
				"label": "Ship Date",
				"component": "ADate",
				"modalComponent": "ADatePicker",
				"align": "center",
				"edit": true,
				"width": "20ch",
				"format": "value => value ? new Date(value).toLocaleDateString('en-US') : '—'"
			},
			{
				"fieldname": "status",
				"label": "Status",
				"component": "ASegmentedControl",
				"align": "center",
				"edit": true,
				"width": "14ch",
				"options": {
					"choices": ["Confirmed", "Pending", "Backordered"],
					"badges": {
						"Confirmed": "success",
						"Pending": "warning",
						"Backordered": "danger"
					}
				}
			}
		],
		"config": {
			"view": "list",
			"fullWidth": true
		}
	}
]
