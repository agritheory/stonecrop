		"graphql_middleware",
		"node_editor",
		"nuxt",
		"nuxt_grafserv",
		"rigs/stonecrop-rig",
		"rockfoil",
		"schema",
		"stonecrop",
		"themes",
		"tools/doc-gen",
		"utilities"
	],
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.13.1",
			"onFail": "download"
		}
	}
}
