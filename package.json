{
	"name": "stonecrop-monorepo",
	"private": true,
	"description": "Workspace root. pnpm installs the members listed in pnpm-workspace.yaml; Vite+ runs every task.",
	"type": "module",
	"scripts": {
		"build": "vp run -r build && bash common/scripts/run-docs.sh --aggregate",
		"check:deps": "node common/scripts/check-dependency-consistency.mjs",
		"docs": "vp run -r docs",
		"docs:full": "bash common/scripts/docs-full.sh",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "vp run -r lint",
		"prepare": "vp config --no-agent",
		"test": "vp run -r test",
		"test:types": "vp run -r test:types"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.1",
		"typescript": "catalog:",
		"vite-plus": "0.3.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.13.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@11.13.1"
}
