{
	"name": "@stonecrop/graphql-middleware",
	"version": "0.29.0",
	"description": "GraphQL middleware for PostGraphile and Stonecrop schema",
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "graphql_middleware"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"types": "./dist/graphql-middleware.d.ts",
	"exports": {
		".": {
			"types": "./dist/graphql-middleware.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build && node --run docs",
		"docs": "bash ../common/scripts/run-docs.sh graphql_middleware",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build && node --run docs",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@dataplan/pg": "^1.0.3",
		"@stonecrop/schema": "workspace:*",
		"graphql": "^16.14.0",
		"postgraphile": "^5.0.3"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.4.5",
		"@microsoft/api-extractor": "^7.58.7",
		"@types/node": "^24.12.4",
		"@types/pg": "^8.11.0",
		"@vitest/coverage-istanbul": "^4.1.5",
		"@vitest/ui": "^4.1.5",
		"oxlint": "1.67.0",
		"oxlint-tsgolint": "0.23.0",
		"pg": "^8.20.0",
		"pglite-server": "^0.1.5",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.5"
	}
}
