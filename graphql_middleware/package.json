{
	"name": "@stonecrop/graphql-middleware",
	"version": "0.8.10",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"_phase:build": "heft build && vite build && rushx docs",
		"prepublish": "heft build && vite build && rushx docs",
		"build": "heft build && vite build && rushx docs",
		"docs": "bash ../common/scripts/run-docs.sh graphql_middleware",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@stonecrop/schema": "workspace:*",
		"graphql": "^16.12.0",
		"pluralize": "^8.0.0",
		"postgraphile": "^5.0.0-rc.7"
	},
	"devDependencies": {
		"@rushstack/heft": "^1.2.0",
		"@types/node": "^22.19.5",
		"@types/pluralize": "^0.0.33",
		"stonecrop-rig": "workspace:*",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	}
}
