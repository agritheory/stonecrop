{
	"name": "@stonecrop/graphql-middleware",
	"version": "0.11.7",
	"type": "module",
	"types": "./dist/graphql-middleware.d.ts",
	"exports": {
		".": {
			"types": "./dist/graphql-middleware.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"description": "GraphQL middleware for PostGraphile and Stonecrop schema",
	"scripts": {
		"_phase:build": "heft build && vite build && rushx docs",
		"prepublishOnly": "heft build && vite build && rushx docs",
		"build": "heft build && vite build && rushx docs",
		"docs": "bash ../common/scripts/run-docs.sh graphql_middleware",
		"test": "vitest run --coverage.enabled false",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui"
	},
	"dependencies": {
		"@stonecrop/schema": "workspace:*",
		"graphql": "^16.13.2",
		"pluralize": "^8.0.0",
		"postgraphile": "^5.0.1"
	},
	"devDependencies": {
		"@rushstack/heft": "^1.2.17",
		"@types/node": "^22.19.17",
		"@types/pluralize": "^0.0.33",
		"@vitest/coverage-istanbul": "^4.1.5",
		"@vitest/ui": "^4.1.5",
		"stonecrop-rig": "workspace:*",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vitest": "^4.1.5"
	}
}
