{
	"name": "@stonecrop/graphql-middleware",
	"version": "0.29.0",
	"description": "GraphQL middleware for PostGraphile and Stonecrop schema",
	"keywords": [
		"graphql",
		"middleware",
		"postgraphile",
		"schema",
		"stonecrop"
	],
	"homepage": "https://github.com/agritheory/stonecrop#readme",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "graphql_middleware"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/graphql-middleware.d.ts",
	"exports": {
		".": {
			"types": "./dist/graphql-middleware.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"docs": "bash ../common/scripts/run-docs.sh graphql_middleware",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "vp run build",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@dataplan/pg": "^1.0.3",
		"@stonecrop/schema": "workspace:*",
		"graphql": "catalog:",
		"postgraphile": "catalog:"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.4.5",
		"@microsoft/api-extractor": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "^8.11.0",
		"@vitest/coverage-istanbul": "catalog:",
		"@vitest/ui": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"pg": "^8.20.0",
		"pglite-server": "^0.1.5",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
