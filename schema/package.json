{
	"name": "@stonecrop/schema",
	"version": "0.29.0",
	"description": "Stonecrop schema definitions and validation tooling",
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "schema"
	},
	"bin": {
		"stonecrop-schema": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/schema.d.ts",
	"exports": {
		".": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build && node --run docs",
		"docs": "bash ../common/scripts/run-docs.sh schema",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build && node --run docs",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"graphql": "catalog:",
		"pluralize": "^8.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "catalog:",
		"@types/node": "catalog:",
		"@types/pluralize": "^0.0.33",
		"@vitest/coverage-istanbul": "catalog:",
		"jsdom": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
