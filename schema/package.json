{
	"name": "@stonecrop/schema",
	"version": "0.16.6",
	"description": "Stonecrop schema definitions and validation tooling",
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "schema"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/schema.d.ts",
	"bin": {
		"stonecrop-schema": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"_phase:build": "heft build --clean && vite build && rushx docs",
		"build": "heft build --clean && vite build && rushx docs",
		"docs": "bash ../common/scripts/run-docs.sh schema",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "heft build --clean && vite build && rushx docs",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"graphql": "^16.14.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@microsoft/api-documenter": "^7.30.5",
		"@rushstack/heft": "^1.2.17",
		"@types/node": "^24.12.4",
		"@vitest/coverage-istanbul": "^4.1.5",
		"jsdom": "^29.1.1",
		"oxlint": "1.67.0",
		"oxlint-tsgolint": "0.23.0",
		"stonecrop-rig": "workspace:*",
		"typescript": "^6.0.3",
		"vite": "^7.3.2",
		"vitest": "^4.1.5"
	}
}
