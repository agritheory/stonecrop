{
	"name": "@stonecrop/schema",
	"version": "0.7.7",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"_phase:build": "heft build && vite build && rushx docs",
		"prepublish": "heft build && vite build && rushx docs",
		"build": "heft build && vite build && rushx docs",
		"docs": "bash ../common/scripts/run-docs.sh schema",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:watch": "vitest watch",
		"test:ui": "vitest --ui"
	},
	"dependencies": {
		"pgsql-ast-parser": "^12.0.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@rushstack/heft": "^1.1.7",
		"@types/node": "^22.19.5",
		"stonecrop-rig": "workspace:*",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.0.17"
	}
}
