{
	"name": "@stonecrop/node-editor",
	"version": "0.12.0",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "node_editor"
	},
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"types": "./dist/node-editor.d.ts",
	"exports": {
		".": {
			"types": "./dist/node-editor.d.ts",
			"import": "./dist/node-editor.js"
		},
		"./styles": "./dist/node-editor.css",
		"./types": "./dist/src/types/index.d.ts"
	},
	"files": [
		"dist/*",
		"src/*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"_phase:build": "heft build && vite build && rushx docs",
		"prepublishOnly": "heft build && vite build && rushx docs",
		"build": "heft build && vite build && rushx docs",
		"dev": "vite",
		"docs": "bash ../common/scripts/run-docs.sh node_editor",
		"lint": "eslint .",
		"preview": "vite preview"
	},
	"dependencies": {
		"@vue-flow/core": "^1.48.1",
		"xstate": "^5.25.0"
	},
	"peerDependencies": {
		"vue": "^3.5.33",
		"vue-router": "^5.0.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@microsoft/api-documenter": "^7.30.5",
		"@rushstack/heft": "^1.2.17",
		"@vitejs/plugin-vue": "^6.0.6",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.9.0",
		"globals": "^17.6.0",
		"stonecrop-rig": "workspace:*",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.1",
		"vue": "^3.5.33",
		"vue-router": "^5.0.6",
		"vite": "^7.3.2"
	},
	"description": "Node editor UI for Stonecrop",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
