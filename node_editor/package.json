{
	"name": "@stonecrop/node-editor",
	"version": "0.29.0",
	"description": "Node editor UI for Stonecrop",
	"keywords": [
		"components",
		"graph",
		"node-editor",
		"stonecrop",
		"vue",
		"workflow"
	],
	"homepage": "https://github.com/agritheory/stonecrop#readme",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "node_editor"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/node-editor.js"
		},
		"./styles": "./dist/node-editor.css",
		"./types": "./dist/src/types/index.d.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite",
		"docs": "bash ../common/scripts/run-docs.sh node_editor",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "vp run build",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:types": "vue-tsc --noEmit",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.0.0",
		"@stonecrop/schema": "workspace:*",
		"@vue-flow/core": "^1.48.1"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"@vitest/coverage-istanbul": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vue": "catalog:",
		"vue-component-meta": "catalog:",
		"vue-router": "catalog:",
		"vue-tsc": "catalog:"
	},
	"peerDependencies": {
		"vue": "^3.5.33",
		"vue-router": "^5.0.6"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
