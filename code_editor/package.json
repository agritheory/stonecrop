{
	"name": "@stonecrop/code-editor",
	"version": "0.29.0",
	"description": "Monaco-based code editor component for Stonecrop",
	"keywords": [
		"code-editor",
		"components",
		"monaco",
		"stonecrop",
		"vue"
	],
	"homepage": "https://github.com/agritheory/stonecrop#readme",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "code_editor"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.vue",
		"**/*.css"
	],
	"types": "./dist/code-editor.d.ts",
	"exports": {
		".": {
			"types": "./dist/code-editor.d.ts",
			"import": "./dist/code-editor.js"
		},
		"./styles": "./dist/code-editor.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build --logLevel warn && node --run docs",
		"dev": "vite",
		"docs": "bash ../common/scripts/run-docs.sh code_editor",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build --logLevel warn && node --run docs",
		"preview": "vite preview",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:types": "vue-tsc --noEmit",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@monaco-editor/loader": "^1.7.0",
		"monaco-editor": "catalog:"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"@vue/test-utils": "catalog:",
		"jsdom": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vue": "catalog:",
		"vue-router": "catalog:",
		"vue-tsc": "catalog:"
	},
	"peerDependencies": {
		"vue": "^3.5.33"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
