		"xstate": "^5.25.0"
	},
	"devDependencies": {
		"@microsoft/api-documenter": "^7.30.5",
		"@rushstack/heft": "^1.2.17",
		"@vitejs/plugin-vue": "^6.0.6",
		"oxlint": "1.67.0",
		"oxlint-tsgolint": "0.23.0",
		"stonecrop-rig": "workspace:*",
		"typescript": "^6.0.3",
		"vite": "^7.3.2",
		"vue": "^3.5.33",
		"vue-router": "^5.0.6"
	},
	"peerDependencies": {
		"vue": "^3.5.33"
	},
