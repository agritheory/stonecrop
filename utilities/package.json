{
	"name": "@stonecrop/utilities",
	"version": "0.6.3",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "utilities"
	},
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/utilities.js"
			},
			"require": "./dist/utilities.umd.cjs"
		},
		"./types": {
			"import": "./dist/src/types/index.d.ts",
			"require": "./dist/src/types/index.d.ts"
		}
	},
	"typings": "./dist/src/index.d.ts",
	"files": [
		"dist/*",
		"src/*"
	],
	"scripts": {
		"_phase:build": "heft build && vite build && rushx docs",
		"prepublish": "heft build && vite build && rushx docs",
		"build": "heft build && vite build && rushx docs",
		"dev": "vite",
		"docs": "bash ../common/scripts/run-docs.sh utilities",
		"lint": "eslint .",
		"preview": "vite preview"
	},
	"dependencies": {
		"@vueuse/core": "^14.1.0",
		"vue": "^3.5.26"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@microsoft/api-documenter": "^7.28.2",
		"@rushstack/heft": "^1.1.7",
		"@vitejs/plugin-vue": "^6.0.3",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.6.2",
		"globals": "^17.0.0",
		"stonecrop-rig": "workspace:*",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.52.0",
		"vite": "^7.3.0",
		"vue-router": "^4.6.4"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
