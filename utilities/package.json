{
	"name": "@stonecrop/utilities",
	"version": "0.29.0",
	"description": "Shared utility functions for Stonecrop",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "utilities"
	},
	"files": [
		"dist/*",
		"src/*"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/utilities.d.ts",
	"exports": {
		".": {
			"types": "./dist/utilities.d.ts",
			"import": "./dist/utilities.js"
		},
		"./types": "./dist/src/types/index.d.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build && node --run docs",
		"dev": "vite",
		"docs": "bash ../common/scripts/run-docs.sh utilities",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build && node --run docs",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@vueuse/core": "catalog:"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"@vitest/coverage-istanbul": "catalog:",
		"@vue/test-utils": "catalog:",
		"jsdom": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vue": "catalog:",
		"vue-router": "catalog:"
	},
	"peerDependencies": {
		"vue": "^3.5.33"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
