{
	"name": "@stonecrop/nuxt-grafserv",
	"version": "0.16.4",
	"description": "Pluggable Grafserv GraphQL server as Nuxt Module",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "nuxt_grafserv"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/module.mjs",
			"types": "./dist/module.d.mts"
		},
		"./runtime/*": "./dist/runtime/*"
	},
	"main": "./dist/module.mjs",
	"types": "./dist/module.d.mts",
	"typesVersions": {
		"*": {
			".": [
				"./dist/module.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"_phase:build": "rushx dev:prepare && rushx prepack",
		"build": "rushx dev:prepare && rushx prepack",
		"build:module": "rushx dev:prepare && rushx prepack",
		"dev": "node playground/scripts/bootstrap.mjs && nuxi dev playground --host",
		"dev:build": "nuxi build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
		"docs": "echo 'Nuxt modules use custom build system - skipping API docs generation'",
		"lint": "eslint .",
		"prepack": "nuxt-module-build build",
		"test": "vitest run",
		"test:ci": "vitest run --run",
		"test:coverage": "vitest run --coverage.enabled --coverage.provider=istanbul",
		"test:e2e": "vitest run test/e2e",
		"test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@graphql-tools/graphql-file-loader": "^8.1.14",
		"@graphql-tools/load": "^8.1.10",
		"@graphql-tools/stitch": "^10.1.18",
		"@graphql-tools/wrap": "^11.1.14",
		"@stonecrop/graphql-middleware": "workspace:*",
		"grafast": "^1.0.2",
		"grafserv": "^1.0.0",
		"graphql": "^16.14.0",
		"postgraphile": "^5.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nuxt/devtools": "^3.2.4",
		"@nuxt/eslint-config": "^1.16.0",
		"@nuxt/kit": "^4.4.4",
		"@nuxt/module-builder": "^1.0.2",
		"@nuxt/schema": "^4.4.8",
		"@nuxt/test-utils": "^4.0.3",
		"@types/node": "^24.12.4",
		"@vitest/coverage-istanbul": "^4.1.5",
		"changelogen": "^0.6.2",
		"eslint": "^10.6.0",
		"h3": "^1.15.11",
		"jsdom": "^29.1.1",
		"nitropack": "^2.13.1",
		"nuxt": "^4.4.8",
		"postgraphile": "^5.0.3",
		"typescript": "^6.0.3",
		"vite": "^7.3.2",
		"vitest": "^4.1.5",
		"vue": "^3.5.33",
		"vue-router": "^5.0.6",
		"vue-tsc": "^3.3.6"
	},
	"peerDependencies": {
		"@stonecrop/casl-middleware": "*",
		"@stonecrop/rockfoil": "*",
		"graphile-config": "^1.0.1"
	},
	"peerDependenciesMeta": {
		"@stonecrop/casl-middleware": {
			"optional": true
		},
		"@stonecrop/rockfoil": {
			"optional": true
		},
		"graphile-config": {
			"optional": true
		}
	}
}
