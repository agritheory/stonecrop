{
	"name": "User",
	"fields": [
		{
			"fieldname": "id",
			"component": "ATextInput",
			"label": "ID",
			"required": true
		},
		{
			"fieldname": "name",
			"component": "ATextInput",
			"label": "Name",
			"required": true
		},
		{
			"fieldname": "email",
			"component": "ATextInput",
			"label": "Email",
			"required": true,
			"options": {
				"format": "email"
			}
		},
		{
			"fieldname": "role",
			"component": "ADropdown",
			"label": "Role",
			"required": true,
			"options": [
				"admin",
				"user",
				"guest"
			]
		},
		{
			"fieldname": "createdAt",
			"component": "ADateTime",
			"label": "Created At"
		},
		{
			"fieldname": "updatedAt",
			"component": "ADateTime",
			"label": "Updated At"
		}
	],
	"workflow": {
		"states": [
			"active",
			"suspended",
			"deleted"
		],
		"actions": {
			"suspend": {
				"label": "Suspend User",
				"allowedStates": [
					"active"
				],
				"nextState": "suspended"
			},
			"activate": {
				"label": "Activate User",
				"allowedStates": [
					"suspended"
				],
				"nextState": "active"
			},
			"delete": {
				"label": "Delete User",
				"allowedStates": [
					"active",
					"suspended"
				],
				"nextState": "deleted"
			}
		}
	}
}
