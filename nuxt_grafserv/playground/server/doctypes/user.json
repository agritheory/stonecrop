{
	"name": "User",
	"fields": [
		{
			"kind": "field",
			"fieldname": "id",
			"fieldtype": "Data",
			"label": "ID",
			"required": true
		},
		{
			"kind": "field",
			"fieldname": "name",
			"fieldtype": "Data",
			"label": "Name",
			"required": true
		},
		{
			"kind": "field",
			"fieldname": "email",
			"fieldtype": "Data",
			"label": "Email",
			"required": true,
			"options": {
				"format": "email"
			}
		},
		{
			"kind": "field",
			"fieldname": "role",
			"fieldtype": "Select",
			"label": "Role",
			"required": true,
			"options": {
				"values": ["admin", "user", "guest"]
			}
		},
		{
			"kind": "field",
			"fieldname": "createdAt",
			"fieldtype": "Datetime",
			"label": "Created At"
		},
		{
			"kind": "field",
			"fieldname": "updatedAt",
			"fieldtype": "Datetime",
			"label": "Updated At"
		}
	],
	"workflow": {
		"states": ["active", "suspended", "deleted"],
		"actions": {
			"suspend": {
				"label": "Suspend User",
				"handler": "suspend_user",
				"allowedStates": ["active"],
				"confirm": true
			},
			"activate": {
				"label": "Activate User",
				"handler": "activate_user",
				"allowedStates": ["suspended"]
			},
			"delete": {
				"label": "Delete User",
				"handler": "delete_user",
				"allowedStates": ["active", "suspended"],
				"confirm": true
			}
		}
	}
}
