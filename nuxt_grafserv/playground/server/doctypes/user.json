{
	"name": "User",
	"fields": [
		{
			"fieldname": "id",
			"fieldtype": "Data",
			"label": "ID",
			"required": true
		},
		{
			"fieldname": "name",
			"fieldtype": "Data",
			"label": "Name",
			"required": true
		},
		{
			"fieldname": "email",
			"fieldtype": "Data",
			"label": "Email",
			"required": true,
			"options": {
				"format": "email"
			}
		},
		{
			"fieldname": "role",
			"fieldtype": "Select",
			"label": "Role",
			"required": true,
			"options": {
				"values": [
					"admin",
					"user",
					"guest"
				]
			}
		},
		{
			"fieldname": "createdAt",
			"fieldtype": "Datetime",
			"label": "Created At"
		},
		{
			"fieldname": "updatedAt",
			"fieldtype": "Datetime",
			"label": "Updated At"
		}
	],
	"workflow": {
		"states": [
			"active",
			"suspended",
			"deleted"
		],
		"actions": {
			"suspend": {
				"label": "Suspend User",
				"allowedStates": [
					"active"
				],
				"nextState": "suspended"
			},
			"activate": {
				"label": "Activate User",
				"allowedStates": [
					"suspended"
				],
				"nextState": "active"
			},
			"delete": {
				"label": "Delete User",
				"allowedStates": [
					"active",
					"suspended"
				],
				"nextState": "deleted"
			}
		}
	}
}
