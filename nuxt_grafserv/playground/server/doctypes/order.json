{
	"name": "Order",
	"fields": [
		{
			"fieldname": "id",
			"fieldtype": "Data",
			"label": "ID",
			"required": true
		},
		{
			"fieldname": "userId",
			"fieldtype": "Link",
			"label": "User",
			"required": true,
			"options": {
				"doctype": "User"
			}
		},
		{
			"fieldname": "status",
			"fieldtype": "Select",
			"label": "Status",
			"required": true,
			"options": {
				"values": [
					"pending",
					"processing",
					"shipped",
					"completed",
					"cancelled"
				]
			}
		},
		{
			"fieldname": "total",
			"fieldtype": "Currency",
			"label": "Total",
			"required": true
		},
		{
			"fieldname": "items",
			"fieldtype": "JSON",
			"label": "Items"
		},
		{
			"fieldname": "createdAt",
			"fieldtype": "Datetime",
			"label": "Created At"
		}
	],
	"workflow": {
		"states": [
			"pending",
			"processing",
			"shipped",
			"completed",
			"cancelled"
		],
		"actions": {
			"process": {
				"label": "Start Processing",
				"allowedStates": [
					"pending"
				],
				"nextState": "processing"
			},
			"ship": {
				"label": "Ship Order",
				"allowedStates": [
					"processing"
				],
				"nextState": "shipped"
			},
			"complete": {
				"label": "Mark Completed",
				"allowedStates": [
					"shipped"
				],
				"nextState": "completed"
			},
			"cancel": {
				"label": "Cancel Order",
				"allowedStates": [
					"pending",
					"processing"
				],
				"nextState": "cancelled"
			}
		}
	}
}
