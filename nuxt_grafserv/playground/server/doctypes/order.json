{
	"name": "Order",
	"fields": [
		{
			"fieldname": "id",
			"component": "ATextInput",
			"label": "ID",
			"required": true
		},
		{
			"fieldname": "userId",
			"component": "AFormLink",
			"label": "User",
			"required": true,
			"doctype": "User"
		},
		{
			"fieldname": "status",
			"component": "ADropdown",
			"label": "Status",
			"required": true,
			"options": [
				"pending",
				"processing",
				"shipped",
				"completed",
				"cancelled"
			]
		},
		{
			"fieldname": "total",
			"component": "ANumericInput",
			"label": "Total",
			"required": true
		},
		{
			"fieldname": "items",
			"component": "ACodeEditor",
			"language": "json",
			"label": "Items"
		},
		{
			"fieldname": "createdAt",
			"component": "ADateTime",
			"label": "Created At"
		}
	],
	"workflow": {
		"states": [
			"pending",
			"processing",
			"shipped",
			"completed",
			"cancelled"
		],
		"actions": {
			"process": {
				"label": "Start Processing",
				"allowedStates": [
					"pending"
				],
				"nextState": "processing"
			},
			"ship": {
				"label": "Ship Order",
				"allowedStates": [
					"processing"
				],
				"nextState": "shipped"
			},
			"complete": {
				"label": "Mark Completed",
				"allowedStates": [
					"shipped"
				],
				"nextState": "completed"
			},
			"cancel": {
				"label": "Cancel Order",
				"allowedStates": [
					"pending",
					"processing"
				],
				"nextState": "cancelled"
			}
		}
	}
}
