{
	// Typechecks the module's own source, which nothing did before: `test:types` ran a bare
	// `vue-tsc` against ./tsconfig.json (the module-author context generated by
	// `nuxt-module-build prepare`), and that context cannot type Nuxt's hooks. `nitro:config` and
	// `devtools:customTabs` both reported as invalid hook names there while being correct — the
	// identical `nuxt.hook('nitro:config', ...)` call in @stonecrop/nuxt's own module.ts passes,
	// because that one is only ever checked through its playground.
	//
	// So this extends the *app* context instead, exactly as @stonecrop/nuxt's tsconfig.runtime.json
	// does. The playground is the canonical consumer: it is a real Nuxt app, so its generated
	// context carries the Nitro and devtools augmentations the module is written against.
	//
	// `playground/.nuxt/nuxt.d.ts` must be listed explicitly. `include` here REPLACES the base's
	// include rather than extending it, and the base's first entry is that file — it is what pulls
	// in every ambient augmentation. Omit it and the pass reports a pile of fake errors.
	//
	// Kept separate from tsconfig.test.json on purpose: compiling src and test in one program pulls
	// a second copy of @nuxt/schema in through the test files' @nuxt/kit import, and the hook types
	// then resolve against the wrong one (errors naming `NuxtHooks$1`).
	//
	// Requires `dev:prepare` to have generated `playground/.nuxt` first, as `test:types` already does.
	"extends": "./playground/.nuxt/tsconfig.json",
	"include": ["playground/.nuxt/nuxt.d.ts", "src/**/*.ts"]
}
