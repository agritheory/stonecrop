{
	"name": "@stonecrop/beam",
	"version": "0.29.0",
	"description": "UI component library for Stonecrop",
	"keywords": [
		"components",
		"design-system",
		"stonecrop",
		"ui",
		"vue"
	],
	"homepage": "https://github.com/agritheory/stonecrop#readme",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "beam"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/beam.d.ts",
	"exports": {
		".": {
			"types": "./dist/beam.d.ts",
			"import": "./dist/beam.js"
		},
		"./styles": "./dist/assets/index.css",
		"./types": "./dist/src/types/index.d.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite",
		"docs": "bash ../common/scripts/run-docs.sh beam",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "vp run build",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:types": "vue-tsc --noEmit",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@vueuse/components": "catalog:",
		"@vueuse/core": "catalog:",
		"mqtt": "^5.14.1",
		"onscan.js": "^1.5.2"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "catalog:",
		"@types/node": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"@vitest/coverage-istanbul": "catalog:",
		"@vitest/ui": "catalog:",
		"@vue/test-utils": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"sass": "^1.97.2",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-lib-inject-css": "catalog:",
		"vitest": "catalog:",
		"vue": "catalog:",
		"vue-router": "catalog:",
		"vue-tsc": "catalog:"
	},
	"peerDependencies": {
		"vue": "^3.5.33"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
