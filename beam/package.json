{
	"name": "@stonecrop/beam",
	"version": "0.10.1",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "beam"
	},
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"description": "UI component library for Stonecrop",
	"types": "./dist/beam.d.ts",
	"exports": {
		".": {
			"types": "./dist/beam.d.ts",
			"import": "./dist/beam.js"
		},
		"./styles": "./dist/assets/index.css",
		"./types": "./dist/src/types/index.d.ts"
	},
	"files": [
		"dist/*",
		"src/*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"_phase:build": "heft build && vite build && rushx docs",
		"prepublishOnly": "heft build && vite build && rushx docs",
		"build": "heft build && vite build && rushx docs",
		"dev": "vite",
		"docs": "bash ../common/scripts/run-docs.sh beam",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui"
	},
	"dependencies": {
		"@vueuse/components": "^14.2.1",
		"@vueuse/core": "^14.2.1",
		"mqtt": "^5.14.1",
		"onscan.js": "^1.5.2"
	},
	"peerDependencies": {
		"vue": "^3.5.28"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@microsoft/api-documenter": "^7.28.2",
		"@rushstack/heft": "^1.2.0",
		"@vitejs/plugin-vue": "^6.0.3",
		"@vitest/coverage-istanbul": "^4.0.18",
		"@vitest/ui": "^4.0.18",
		"@vue/test-utils": "^2.4.6",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.6.2",
		"globals": "^17.0.0",
		"sass": "^1.97.2",
		"stonecrop-rig": "workspace:*",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.0",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vite": "^7.3.1",
		"vue": "^3.5.28",
		"vitest": "^4.0.18",
		"vue-router": "^5.0.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
