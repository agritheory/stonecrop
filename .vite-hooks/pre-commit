#!/bin/sh
# Installed by "vp hooks enable", which the root "prepare" script runs after every install.
# Set VP_GIT_HOOKS=0 to skip every hook in a shell that commits without a working checkout.
set -e

log=$(mktemp)
trap 'rm -f "$log"' EXIT

# Each step is silent while it succeeds and dumps its whole log when it does not. A passing commit
# is the common case and used to print ~660 lines of build output, which buried anything worth
# reading; a failing one still gets everything.
step() {
	printf '  %-22s' "$1…"
	shift
	if "$@" >"$log" 2>&1; then
		echo 'ok'
	else
		echo 'FAILED'
		cat "$log"
		exit 1
	fi
}

# Format all files, not just staged ones, so the tree never drifts from CI. Oxfmt also sorts
# package.json, which is why there is no separate sort step: running one alongside it would mean
# two tools with incompatible orderings undoing each other on every commit.
step 'format' node --run format
git add -u

# Runs before the build because it is instant and the fix is a hand edit: a dependency that drifted
# is better reported now than after waiting for a full build.
step 'dependency ranges' node --run check:deps

# The root build ends in "run-docs.sh --aggregate", so the aggregated tree is current by the time
# this returns and only needs staging.
step 'build' node --run build
git add nuxt/documentation/content/reference/
