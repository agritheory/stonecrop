{
	"name": "@stonecrop/casl-middleware",
	"version": "0.49.0",
	"description": "CASL authorization middleware for GraphQL servers",
	"keywords": [
		"authorization",
		"casl",
		"graphql",
		"middleware",
		"postgraphile",
		"rockfoil"
	],
	"homepage": "https://github.com/agritheory/stonecrop#readme",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "support@agritheory.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "casl_middleware"
	},
	"files": [
		"dist",
		"!dist/src"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/casl-middleware.d.ts",
	"exports": {
		".": {
			"types": "./dist/casl-middleware.d.ts",
			"import": "./dist/casl-middleware.js"
		},
		"./types": "./dist/casl-middleware.d.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vp build --watch",
		"docs": "bash ../tools/scripts/run-docs.sh casl_middleware",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"prepublishOnly": "vp run build",
		"preview": "vp preview",
		"test": "vp test run --coverage.enabled false",
		"test:coverage": "vp test run --coverage",
		"test:ui": "vp test --ui",
		"test:watch": "vp test watch"
	},
	"dependencies": {
		"@casl/ability": "^6.8.0",
		"graphql": "catalog:",
		"graphql-tag": "^2.12.6",
		"jsonwebtoken": "^9.0.3"
	},
	"devDependencies": {
		"@graphql-tools/merge": "^9.1.7",
		"@graphql-tools/schema": "^10.0.31",
		"@graphql-tools/utils": "^11.0.0",
		"@microsoft/api-extractor": "catalog:",
		"@types/jsonwebtoken": "~9.0.10",
		"@types/node": "catalog:",
		"@vitest/coverage-istanbul": "catalog:",
		"graphql-middleware": "^6.1.35",
		"graphql-yoga": "catalog:",
		"jsdom": "catalog:",
		"postgraphile": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"graphql-yoga": "^5.18.0",
		"postgraphile": "^5.0.3"
	},
	"peerDependenciesMeta": {
		"postgraphile": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
