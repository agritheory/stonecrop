{
	"extends": "../tsconfig.options.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"declarationDir": "./dist",
		"baseUrl": ".",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "tests/**/*"]
}
