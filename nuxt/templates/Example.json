{
	"name": "Example",
	"slug": "example/:id",
	"fields": [
		{
			"kind": "field",
			"fieldname": "id",
			"fieldtype": "Data",
			"label": "ID",
			"readOnly": true
		},
		{
			"kind": "field",
			"fieldname": "title",
			"fieldtype": "Data",
			"label": "Title",
			"required": true,
			"width": "30ch"
		},
		{
			"kind": "field",
			"fieldname": "description",
			"fieldtype": "Text",
			"label": "Description"
		},
		{
			"kind": "field",
			"fieldname": "status",
			"fieldtype": "Select",
			"label": "Status",
			"options": ["Draft", "Active", "Archived"],
			"default": "Draft"
		},
		{
			"kind": "field",
			"fieldname": "priority",
			"fieldtype": "Select",
			"label": "Priority",
			"options": ["Low", "Medium", "High"],
			"default": "Medium"
		},
		{
			"kind": "field",
			"fieldname": "assignee",
			"fieldtype": "Link",
			"label": "Assignee",
			"options": "User"
		},
		{
			"kind": "field",
			"fieldname": "dueDate",
			"fieldtype": "Date",
			"label": "Due Date"
		},
		{
			"kind": "field",
			"fieldname": "createdAt",
			"fieldtype": "Datetime",
			"label": "Created At",
			"readOnly": true
		},
		{
			"kind": "field",
			"fieldname": "updatedAt",
			"fieldtype": "Datetime",
			"label": "Updated At",
			"readOnly": true
		}
	],
	"workflow": {
		"states": ["Draft", "Active", "Archived"],
		"actions": {
			"activate": {
				"label": "Activate",
				"handler": "activate_example",
				"allowedStates": ["Draft"],
				"confirm": true
			},
			"archive": {
				"label": "Archive",
				"handler": "archive_example",
				"allowedStates": ["Active"],
				"confirm": true
			},
			"reopen": {
				"label": "Reopen",
				"handler": "reopen_example",
				"allowedStates": ["Archived"],
				"confirm": false
			}
		}
	}
}
