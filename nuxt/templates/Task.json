{
	"name": "Task",
	"slug": "task",
	"fields": [
		{
			"fieldname": "id",
			"primaryKey": true,
			"label": "ID",
			"component": "ATextInput",
			"mode": "display"
		},
		{
			"fieldname": "title",
			"label": "Title",
			"component": "ATextInput",
			"required": true
		},
		{
			"fieldname": "projectId",
			"label": "Project",
			"component": "AFormLink",
			"doctype": "project",
			"required": true
		},
		{
			"fieldname": "status",
			"label": "Status",
			"component": "ADropdown",
			"options": ["Todo", "In Progress", "Done"],
			"default": "Todo"
		},
		{
			"fieldname": "description",
			"label": "Description",
			"component": "ATextboxInput"
		},
		{
			"fieldname": "dueDate",
			"label": "Due Date",
			"component": "ADatePicker"
		},
		{
			"fieldname": "createdAt",
			"label": "Created At",
			"component": "ADateTime",
			"mode": "display"
		}
	],
	"workflow": {
		"states": ["Todo", "In Progress", "Done"],
		"actions": {
			"save": {
				"label": "Save",
				"stateless": true,
				"selfTransition": true
			},
			"snooze": {
				"label": "Snooze a Week",
				"stateless": true
			},
			"start_task": {
				"label": "Start Task",
				"allowedStates": ["Todo"],
				"nextState": "In Progress"
			},
			"complete_task": {
				"label": "Complete",
				"allowedStates": ["In Progress"],
				"nextState": "Done"
			}
		}
	}
}
