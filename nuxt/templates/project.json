{
	"name": "Project",
	"slug": "project",
	"fields": [
		{
			"fieldname": "id",
			"primaryKey": true,
			"label": "ID",
			"component": "ATextInput",
			"mode": "display"
		},
		{
			"fieldname": "title",
			"label": "Title",
			"component": "ATextInput",
			"required": true
		},
		{
			"fieldname": "description",
			"label": "Description",
			"component": "ATextboxInput"
		},
		{
			"fieldname": "status",
			"label": "Status",
			"component": "ADropdown",
			"options": ["Active", "Archived"]
		},
		{
			"fieldname": "createdAt",
			"label": "Created At",
			"component": "ADateTime",
			"mode": "display"
		}
	],
	"defaults": {
		"status": "Active"
	},
	"workflow": {
		"states": ["Active", "Archived"],
		"actions": {
			"save": {
				"label": "Save",
				"stateless": true,
				"selfTransition": true
			},
			"archive": {
				"label": "Archive Project",
				"allowedStates": ["Active"],
				"nextState": "Archived"
			}
		}
	}
}
