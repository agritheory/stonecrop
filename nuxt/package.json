{
	"name": "@stonecrop/nuxt",
	"version": "0.4.36",
	"description": "Nuxt module for Stonecrop",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "nuxt"
	},
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"_phase:build": "rushx dev:prepare && nuxt-module-build build",
		"prepublish": "rushx dev:prepare && nuxt-module-build build",
		"prepack": "rushx dev:prepare && nuxt-module-build build",
		"build": "rushx dev:prepare && nuxt-module-build build",
		"dev": "rushx dev:prepare && nuxi dev playground",
		"dev:build": "nuxi build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
		"lint": "eslint .",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch",
		"test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
	},
	"dependencies": {
		"@nuxt/kit": "^4.1.3",
		"@stonecrop/aform": "workspace:*",
		"@stonecrop/atable": "workspace:*",
		"@stonecrop/stonecrop": "workspace:*",
		"pinia": "^3.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@nuxt/devtools": "^3.0.0",
		"@nuxt/eslint-config": "^1.10.0",
		"@nuxt/module-builder": "^1.0.2",
		"@nuxt/schema": "^4.2.0",
		"@nuxt/test-utils": "^3.20.1",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.5.1",
		"globals": "^16.4.0",
		"happy-dom": "^20.0.10",
		"nuxt": "^4.2.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"vue": "^3.5.22",
		"vite": "^7.1.1",
		"vitest": "^3.2.4",
		"vue-router": "^4.6.3",
		"vue-tsc": "^2.2.12"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
