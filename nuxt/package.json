{
	"name": "@stonecrop/nuxt",
	"version": "0.4.25",
	"description": "Nuxt module for Stonecrop",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "nuxt"
	},
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"_phase:build": "rushx dev:prepare && nuxt-module-build build",
		"prepublish": "rushx dev:prepare && nuxt-module-build build",
		"prepack": "rushx dev:prepare && nuxt-module-build build",
		"build": "rushx dev:prepare && nuxt-module-build build",
		"dev": "nuxi dev playground",
		"dev:build": "nuxi build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
		"lint": "eslint . --ext .ts,.vue",
		"test": "vitest",
		"test:ui": "vitest --ui"
	},
	"dependencies": {
		"@nuxt/kit": "^3.17.6",
		"@stonecrop/aform": "workspace:*",
		"@stonecrop/atable": "workspace:*",
		"@stonecrop/stonecrop": "workspace:*",
		"pinia": "^3.0.3"
	},
	"devDependencies": {
		"@nuxt/devtools": "^2.6.2",
		"@nuxt/module-builder": "^1.0.1",
		"@nuxt/schema": "^3.17.6",
		"@nuxt/test-utils": "^3.19.2",
		"eslint": "^8.57.1",
		"happy-dom": "^18.0.1",
		"h3": "*",
		"nitropack": "*",
		"nuxi": "^3.25.1",
		"nuxt": "^3.17.6",
		"typescript": "^5.8.3",
		"vue": "^3.5.17",
		"vite": "^6.3.5",
		"vitest": "^3.2.4",
		"vue-router": "^4.5.1",
		"vue-tsc": "~2.2.10"
	}
}
