{
	"name": "@stonecrop/nuxt",
	"version": "0.8.2",
	"description": "Nuxt module for Stonecrop",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "nuxt"
	},
	"bin": {
		"stonecrop-nuxt": "./bin/init.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"files": [
		"dist",
		"bin",
		"templates",
		"src/cli"
	],
	"scripts": {
		"_phase:build": "rushx dev:prepare && nuxt-module-build build",
		"prepublish": "rushx dev:prepare && nuxt-module-build build",
		"prepack": "rushx dev:prepare && nuxt-module-build build",
		"build": "rushx dev:prepare && nuxt-module-build build",
		"docs": "echo 'Nuxt modules use custom build system - skipping API docs generation'",
		"dev": "rushx dev:prepare && nuxi dev playground",
		"dev:basic": "rushx dev:prepare && nuxi dev playground",
		"dev:full": "rushx dev:prepare:full && nuxi dev fullstack",
		"dev:prepare:full": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare fullstack",
		"dev:build": "nuxi build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground && nuxi prepare fullstack",
		"lint": "eslint .",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest watch",
		"test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
	},
	"dependencies": {
		"@nuxt/kit": "^4.3.1",
		"@stonecrop/aform": "workspace:*",
		"@stonecrop/atable": "workspace:*",
		"@stonecrop/casl-middleware": "workspace:*",
		"@stonecrop/graphql-middleware": "workspace:*",
		"@stonecrop/node-editor": "workspace:*",
		"@stonecrop/nuxt-grafserv": "workspace:*",
		"@stonecrop/schema": "workspace:*",
		"@stonecrop/stonecrop": "workspace:*",
		"pinia": "^3.0.4",
		"citty": "^0.2.1",
		"consola": "^3.4.0",
		"jiti": "^2.4.2",
		"pathe": "^2.0.3",
		"prompts": "^2.4.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@nuxt/devtools": "^3.1.1",
		"@nuxt/eslint-config": "^1.12.1",
		"@nuxt/eslint": "1.12.1",
		"@nuxt/module-builder": "^1.0.2",
		"@nuxt/schema": "^4.3.1",
		"@nuxt/test-utils": "^4.0.0",
		"@types/prompts": "^2.4.9",
		"@vitest/coverage-istanbul": "^4.0.18",
		"baseline-browser-mapping": "latest",
		"browserslist": "latest",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.6.2",
		"eslint": "^9.39.2",
		"globals": "^17.0.0",
		"nuxt": "^4.3.1",
		"postgraphile": "^5.0.0-rc.7",
		"typescript-eslint": "^8.53.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"vue-router": "^5.0.2",
		"vue-tsc": "^3.2.2",
		"vue": "^3.5.28"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
