{
	"name": "@stonecrop/nuxt",
	"version": "0.6.2",
	"description": "Nuxt module for Stonecrop",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "nuxt"
	},
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"_phase:build": "rushx dev:prepare && nuxt-module-build build",
		"prepublish": "rushx dev:prepare && nuxt-module-build build",
		"prepack": "rushx dev:prepare && nuxt-module-build build",
		"build": "rushx dev:prepare && nuxt-module-build build",
		"dev": "rushx dev:prepare && nuxi dev playground",
		"dev:build": "nuxi build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
		"lint": "eslint .",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch",
		"test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
	},
	"dependencies": {
		"@nuxt/kit": "^4.2.2",
		"@stonecrop/aform": "workspace:*",
		"@stonecrop/atable": "workspace:*",
		"@stonecrop/node-editor": "workspace:*",
		"@stonecrop/stonecrop": "workspace:*",
		"pinia": "^3.0.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@nuxt/devtools": "^3.1.1",
		"@nuxt/eslint": "1.12.1",
		"@nuxt/eslint-config": "^1.12.1",
		"@nuxt/module-builder": "^1.0.2",
		"@nuxt/schema": "^4.2.2",
		"@nuxt/test-utils": "^3.22.0",
		"baseline-browser-mapping": "latest",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.6.2",
		"globals": "^17.0.0",
		"nuxt": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.51.0",
		"vue": "^3.5.26",
		"vite": "^7.3.0",
		"vitest": "^4.0.16",
		"vue-router": "^4.6.4",
		"vue-tsc": "^3.2.1"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
