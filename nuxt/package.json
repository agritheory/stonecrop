{
	"name": "@stonecrop/nuxt",
	"version": "0.16.6",
	"description": "Nuxt module for Stonecrop",
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "nuxt"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"bin": {
		"stonecrop-nuxt": "./bin/init.mjs"
	},
	"files": [
		"dist",
		"bin",
		"templates",
		"src/cli"
	],
	"scripts": {
		"_phase:build": "rushx dev:prepare && nuxt-module-build build",
		"build": "rushx dev:prepare && nuxt-module-build build",
		"dev": "rushx dev:prepare && nuxi dev playground --host",
		"dev:build": "nuxi build playground",
		"dev:full": "rushx dev:prepare:full && nuxi dev fullstack --host",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground && nuxi prepare fullstack",
		"dev:prepare:full": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare fullstack",
		"docs": "echo 'Nuxt modules use custom build system - skipping API docs generation'",
		"lint": "eslint .",
		"prepack": "rushx dev:prepare && nuxt-module-build build",
		"prepublish": "rushx dev:prepare && nuxt-module-build build",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage.enabled --coverage.provider=istanbul",
		"test:types": "vue-tsc --noEmit -p tsconfig.runtime.json && cd playground && vue-tsc --noEmit && cd ../fullstack && vue-tsc --noEmit && vue-tsc --noEmit -p server/tsconfig.json",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@nuxt/kit": "^4.4.4",
		"@stonecrop/aform": "workspace:*",
		"@stonecrop/atable": "workspace:*",
		"@stonecrop/casl-middleware": "workspace:*",
		"@stonecrop/code-editor": "workspace:*",
		"@stonecrop/desktop": "workspace:*",
		"@stonecrop/graphql-client": "workspace:*",
		"@stonecrop/graphql-middleware": "workspace:*",
		"@stonecrop/node-editor": "workspace:*",
		"@stonecrop/nuxt-grafserv": "workspace:*",
		"@stonecrop/schema": "workspace:*",
		"@stonecrop/stonecrop": "workspace:*",
		"@stonecrop/themes": "workspace:*",
		"citty": "^0.2.2",
		"consola": "^3.4.2",
		"h3": "^1.15.11",
		"jiti": "^2.7.0",
		"pathe": "^2.0.3",
		"pinia": "^3.0.4",
		"prompts": "^2.4.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nuxt/devtools": "^3.2.4",
		"@nuxt/eslint": "1.16.0",
		"@nuxt/eslint-config": "^1.16.0",
		"@nuxt/module-builder": "^1.0.2",
		"@nuxt/schema": "^4.4.8",
		"@nuxt/test-utils": "^4.0.3",
		"@types/prompts": "^2.4.9",
		"@vitest/coverage-istanbul": "^4.1.5",
		"baseline-browser-mapping": "latest",
		"browserslist": "latest",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.9.2",
		"globals": "^17.6.0",
		"graphql": "^16.14.0",
		"monaco-editor": "^0.55.1",
		"nuxt": "^4.4.8",
		"nuxt-graphql-middleware": "^5.4.0",
		"postgraphile": "^5.0.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1",
		"vite": "^7.3.2",
		"vitest": "^4.1.5",
		"vue": "^3.5.33",
		"vue-router": "^5.0.6",
		"vue-tsc": "^3.3.6"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
