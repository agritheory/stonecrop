{
	"name": "@stonecrop/nuxt",
	"version": "0.33.0",
	"description": "Nuxt module for Stonecrop",
	"keywords": [
		"nuxt",
		"nuxt-module",
		"stonecrop",
		"vue"
	],
	"homepage": "https://github.com/agritheory/stonecrop#readme",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "nuxt"
	},
	"bin": {
		"stonecrop-nuxt": "./bin/init.mjs"
	},
	"files": [
		"dist",
		"bin",
		"templates",
		"src/cli"
	],
	"type": "module",
	"sideEffects": [
		"**/*.vue",
		"**/*.css"
	],
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "node --run dev:prepare && nuxi dev playground --host",
		"dev:build": "nuxi build playground",
		"dev:documentation": "node --run dev:prepare:documentation && nuxi dev documentation --host",
		"dev:full": "node --run dev:prepare:full && nuxi dev fullstack --host",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && sh scripts/nuxt-apps.sh prepare",
		"dev:prepare:documentation": "nuxi prepare documentation",
		"dev:prepare:full": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare fullstack",
		"docs": "echo 'Nuxt modules use custom build system - skipping API docs generation'",
		"generate:documentation": "nuxi generate documentation",
		"lint": "eslint .",
		"prepack": "node --run dev:prepare && nuxt-module-build build",
		"prepublish": "node --run dev:prepare && nuxt-module-build build",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage.enabled --coverage.provider=istanbul",
		"test:types": "vue-tsc --noEmit -p tsconfig.runtime.json && vue-tsc --noEmit -p tsconfig.templates-app.json && vue-tsc --noEmit -p tsconfig.templates-server.json && sh scripts/nuxt-apps.sh typecheck",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@nuxt/kit": "catalog:",
		"@stonecrop/aform": "workspace:*",
		"@stonecrop/atable": "workspace:*",
		"@stonecrop/casl-middleware": "workspace:*",
		"@stonecrop/code-editor": "workspace:*",
		"@stonecrop/desktop": "workspace:*",
		"@stonecrop/graphql-client": "workspace:*",
		"@stonecrop/graphql-middleware": "workspace:*",
		"@stonecrop/node-editor": "workspace:*",
		"@stonecrop/nuxt-grafserv": "workspace:*",
		"@stonecrop/schema": "workspace:*",
		"@stonecrop/stonecrop": "workspace:*",
		"@stonecrop/themes": "workspace:*",
		"citty": "^0.2.2",
		"consola": "^3.4.2",
		"h3": "catalog:",
		"jiti": "^2.7.0",
		"pathe": "^2.0.3",
		"pinia": "catalog:",
		"prompts": "^2.4.2"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@nuxt/content": "^3.0.0",
		"@nuxt/devtools": "catalog:",
		"@nuxt/eslint": "1.16.0",
		"@nuxt/eslint-config": "catalog:",
		"@nuxt/module-builder": "catalog:",
		"@nuxt/schema": "catalog:",
		"@nuxt/test-utils": "catalog:",
		"@types/prompts": "^2.4.9",
		"@vitest/coverage-istanbul": "catalog:",
		"baseline-browser-mapping": "latest",
		"browserslist": "latest",
		"eslint": "catalog:",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.9.2",
		"globals": "^17.6.0",
		"graphql": "catalog:",
		"monaco-editor": "catalog:",
		"nuxt": "catalog:",
		"nuxt-graphql-middleware": "^5.4.0",
		"postgraphile": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "^8.62.1",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vue": "catalog:",
		"vue-router": "catalog:",
		"vue-tsc": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
