{
	"name": "Order",
	"slug": "order",
	"fields": [
		{
			"fieldname": "id",
			"label": "ID",
			"component": "ATextInput",
			"fieldtype": "Data",
			"mode": "display"
		},
		{
			"fieldname": "orderNumber",
			"label": "Order Number",
			"component": "ATextInput",
			"fieldtype": "Data",
			"mode": "display"
		},
		{
			"fieldname": "userId",
			"label": "Customer",
			"component": "ACombobox",
			"fieldtype": "Link",
			"options": "user",
			"required": true
		},
		{
			"fieldname": "status",
			"label": "Status",
			"component": "ADropdown",
			"fieldtype": "Select",
			"options": ["DRAFT", "PENDING", "PROCESSING", "SHIPPED", "COMPLETED", "CANCELLED"],
			"default": "DRAFT"
		},
		{
			"fieldname": "total",
			"label": "Total",
			"component": "ATextInput",
			"fieldtype": "Currency",
			"mode": "display"
		},
		{
			"fieldname": "shippingAddress",
			"label": "Shipping Address",
			"component": "ATextarea",
			"fieldtype": "Text"
		},
		{
			"fieldname": "billingAddress",
			"label": "Billing Address",
			"component": "ATextarea",
			"fieldtype": "Text"
		},
		{
			"fieldname": "createdAt",
			"label": "Created At",
			"component": "ATextInput",
			"fieldtype": "Datetime",
			"mode": "display"
		},
		{
			"fieldname": "updatedAt",
			"label": "Updated At",
			"component": "ATextInput",
			"fieldtype": "Datetime",
			"mode": "display"
		}
	],
	"workflow": {
		"states": ["DRAFT", "PENDING", "PROCESSING", "SHIPPED", "COMPLETED", "CANCELLED"],
		"actions": {
			"save": {
				"label": "Save",
				"handler": "order:save",
				"stateless": true
			},
			"submit": {
				"label": "Submit Order",
				"handler": "submit_order",
				"allowedStates": ["DRAFT"],
				"requiredFields": ["userId", "shippingAddress"],
				"nextState": "PENDING"
			},
			"process": {
				"label": "Process Order",
				"handler": "process_order",
				"allowedStates": ["PENDING"],
				"confirm": true,
				"nextState": "PROCESSING"
			},
			"ship": {
				"label": "Ship Order",
				"handler": "ship_order",
				"allowedStates": ["PROCESSING"],
				"confirm": true,
				"nextState": "SHIPPED"
			},
			"complete": {
				"label": "Complete Order",
				"handler": "complete_order",
				"allowedStates": ["SHIPPED"],
				"nextState": "COMPLETED"
			},
			"cancel": {
				"label": "Cancel Order",
				"handler": "cancel_order",
				"allowedStates": ["DRAFT", "PENDING", "PROCESSING"],
				"confirm": true,
				"nextState": "CANCELLED"
			}
		}
	}
}
