{
	"name": "@stonecrop/atable",
	"version": "0.29.0",
	"description": "Advanced data table component for Stonecrop",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "atable"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/atable.d.ts",
			"import": "./dist/atable.js"
		},
		"./styles": "./dist/assets/index.css",
		"./types": "./dist/src/types/index.d.ts"
	},
	"types": "./dist/atable.d.ts",
	"files": [
		"dist/*",
		"src/*"
	],
	"scripts": {
		"_phase:build": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build && node --run docs",
		"build": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build && node --run docs",
		"dev": "vite",
		"docs": "bash ../common/scripts/run-docs.sh atable",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "rm -rf dist && tsc -b --force && api-extractor run --local -c config/api-extractor.json && vite build && node --run docs",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:types": "vue-tsc --noEmit",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@stonecrop/schema": "workspace:*",
		"@stonecrop/themes": "workspace:*",
		"@stonecrop/utilities": "workspace:*",
		"@vueuse/components": "^14.2.1",
		"@vueuse/core": "^14.2.1"
	},
	"devDependencies": {
		"@microsoft/api-documenter": "^7.30.5",
		"@microsoft/api-extractor": "^7.58.7",
		"@types/node": "^24.12.4",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vitest/coverage-istanbul": "^4.1.5",
		"@vitest/ui": "^4.1.5",
		"@vue/test-utils": "^2.4.10",
		"jsdom": "^29.1.1",
		"oxlint": "1.67.0",
		"oxlint-tsgolint": "0.23.0",
		"pinia": "^3.0.4",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vitest": "^4.1.5",
		"vue": "^3.5.33",
		"vue-router": "^5.0.6",
		"vue-tsc": "^3.3.6"
	},
	"peerDependencies": {
		"pinia": "^3.0.4",
		"vue": "^3.5.33"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
