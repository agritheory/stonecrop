@stonecrop:registry=https://registry.npmjs.org/
registry=https://registry.npmjs.org/

# No _authToken line: every dependency here is public, and the publish job authenticates over OIDC
# rather than with a token. Do not add one back as `${NODE_AUTH_TOKEN}` either — pnpm reads this
# file in place, so an unset variable is substituted literally rather than dropped.
