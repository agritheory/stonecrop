@stonecrop:registry=https://registry.npmjs.org/
registry=https://registry.npmjs.org/

# No _authToken line: every dependency here is public, and the publish job authenticates over OIDC
# rather than with a token. Rush stripped `${VAR}` lines whose variable was unset when it copied
# this file; pnpm reads it in place and has no such step, so an unset NODE_AUTH_TOKEN would be
# substituted literally.
