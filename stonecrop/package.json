{
	"name": "@stonecrop/stonecrop",
	"version": "0.30.0",
	"description": "Schema-driven framework with XState workflows and HST state management",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "stonecrop"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/stonecrop.d.ts",
			"import": "./dist/stonecrop.js"
		},
		"./types": "./dist/src/types/index.d.ts"
	},
	"types": "./dist/stonecrop.d.ts",
	"files": [
		"dist/*",
		"src/*"
	],
	"scripts": {
		"_phase:build": "heft build --clean && vite build && rushx docs",
		"build": "heft build --clean && vite build && rushx docs",
		"docs": "bash ../common/scripts/run-docs.sh stonecrop",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "heft build --clean && vite build && rushx docs",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:types": "tsc --noEmit -p tsconfig.typecheck.json",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@stonecrop/aform": "workspace:*",
		"@stonecrop/atable": "workspace:*",
		"@stonecrop/schema": "workspace:*",
		"@vueuse/core": "^14.2.1",
		"immutable": "^5.1.4",
		"pinia-shared-state": "^1.0.1",
		"xstate": "^5.25.0"
	},
	"devDependencies": {
		"@microsoft/api-documenter": "^7.30.5",
		"@rushstack/heft": "^1.2.17",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vitest/coverage-istanbul": "^4.1.5",
		"@vue/test-utils": "^2.4.10",
		"jsdom": "^29.1.1",
		"oxlint": "1.67.0",
		"oxlint-tsgolint": "0.23.0",
		"pinia": "^3.0.4",
		"stonecrop-rig": "workspace:*",
		"typescript": "^6.0.3",
		"vite": "^7.3.2",
		"vitest": "^4.1.5",
		"vue": "^3.5.33",
		"vue-router": "^5.0.6"
	},
	"peerDependencies": {
		"pinia": "^3.0.4",
		"vue": "^3.5.33",
		"vue-router": "^5.0.6"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
