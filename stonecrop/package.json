{
	"name": "@stonecrop/stonecrop",
	"version": "0.30.0",
	"description": "Schema-driven framework with XState workflows and HST state management",
	"keywords": [
		"framework",
		"schema-driven",
		"stonecrop",
		"ui",
		"vue"
	],
	"homepage": "https://github.com/agritheory/stonecrop#readme",
	"bugs": {
		"url": "https://github.com/agritheory/stonecrop/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Tyler Matteson",
		"email": "tyler@agritheory.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/agritheory/stonecrop",
		"directory": "stonecrop"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/stonecrop.d.ts",
	"exports": {
		".": {
			"types": "./dist/stonecrop.d.ts",
			"import": "./dist/stonecrop.js"
		},
		"./types": "./dist/src/types/index.d.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"docs": "bash ../common/scripts/run-docs.sh stonecrop",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepublishOnly": "vp run build",
		"preview": "vite preview",
		"test": "vitest run --coverage.enabled false",
		"test:coverage": "vitest run --coverage",
		"test:types": "tsc --noEmit -p tsconfig.typecheck.json",
		"test:ui": "vitest --ui",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@stonecrop/aform": "workspace:*",
		"@stonecrop/atable": "workspace:*",
		"@stonecrop/schema": "workspace:*",
		"@vueuse/core": "catalog:",
		"immutable": "catalog:",
		"pinia-shared-state": "^1.0.1",
		"xstate": "^5.25.0"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"@vitest/coverage-istanbul": "catalog:",
		"@vue/test-utils": "catalog:",
		"jsdom": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"pinia": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vue": "catalog:",
		"vue-router": "catalog:"
	},
	"peerDependencies": {
		"pinia": "^3.0.4",
		"vue": "^3.5.33",
		"vue-router": "^5.0.6"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
